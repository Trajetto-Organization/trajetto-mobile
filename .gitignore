# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo
app-example

# generated native folders
/ios
/android

# Environment variables
.env*
!.env.example

# EAS credentials, and any other service-account key (the Firebase admin SDK
# key lives next to the repos, in google-firebase-services/; EAS uploads
# whatever git sees).
google-service-account.json
*service-account*.json
*firebase-adminsdk*.json

# OTA code signing (docs/deploy.md, OTA signing section). The certificate is public and
# EAS Build only sees what git sees, so it is let back in past `*.pem`; the
# private key that signs every update never enters the repository.
!certs/certificate.pem
keys/
# Firebase Android client config: carries the project's API key and is
# supplied to EAS as a secret file. app.config.js already guards it with
# fs.existsSync, so a checkout without it still runs (no FCM locally).
google-services.json
*.cer

# Local builds
/builds
/dist
*.apk
*.aab
*.ipa

# Unit test coverage report (npm run test:coverage; CI publishes it)
coverage/

# Mutation testing (npm run test:mutation): Stryker sandbox and reports
.stryker-tmp/
reports/mutation/

# Gradle output of the local Expo modules (modules/*/android), written by a
# local `expo run:android`; EAS builds them from source.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
