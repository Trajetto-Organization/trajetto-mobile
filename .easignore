# What `eas build` uploads. When this file exists EAS reads it INSTEAD of
# .gitignore, so it repeats every rule of .gitignore in the same order (a test
# holds them together: tests/unitaires/eas-build-config.test.ts), except one:
# google-services.json. A local `eas build` then ships the Firebase config
# that git never sees; a CI build gets it from the EAS file variable
# GOOGLE_SERVICES_JSON instead (.env.example).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo
app-example

# generated native folders
/ios
/android

# Environment variables: .env.production holds the EXPO_TOKEN.
.env*
!.env.example

# EAS credentials and any service-account key.
google-service-account.json
*service-account*.json
*firebase-adminsdk*.json

# OTA code signing: the public certificate goes, the private key never does.
!certs/certificate.pem
keys/
*.cer

# Local builds
/builds
/dist
*.apk
*.aab
*.ipa

# Unit test coverage report (npm run test:coverage; CI publishes it)
coverage/

# Mutation testing (npm run test:mutation): Stryker sandbox and reports
.stryker-tmp/
reports/mutation/

# Gradle output of the local Expo modules: EAS builds them from source.
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
