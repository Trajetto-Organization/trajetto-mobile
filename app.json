{
  "expo": {
    "name": "Trajetto",
    "slug": "trajetto-fleet-manager-mobile",
    "version": "1.0.0",
    "owner": "trajetto",
    "orientation": "portrait",
    "description": "Sistema completo de gestão de frotas para empresas. Controle abastecimentos, manutenções, motoristas e veículos em tempo real.",
    "icon": "./assets/images/icon.png",
    "scheme": "trajetto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#2563eb",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "jsEngine": "hermes",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trajetto.fleetmanager",
      "icon": "./assets/images/icon.png",
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "O Trajetto precisa acessar a câmera para registrar fotos do odômetro durante abastecimentos e checklists.",
        "NSPhotoLibraryUsageDescription": "O Trajetto acessa sua galeria para selecionar fotos do odômetro e relatórios de manutenção.",
        "NSLocationWhenInUseUsageDescription": "O Trajetto usa sua localização para registrar o local dos abastecimentos e serviços.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.trajetto.fleetmanager",
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "platforms": ["android", "ios"],
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#0ea5e9",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} novas notificações"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/612e28c2-8647-4f68-b7dd-db9e60a4de2b"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir que $(PRODUCT_NAME) acesse sua câmera para tirar fotos do odômetro."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para permitir que você escolha uma imagem do odômetro."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "612e28c2-8647-4f68-b7dd-db9e60a4de2b"
      }
    }
  }
}
