{
  "expo": {
    "name": "Trajetto",
    "slug": "trajetto-fleet-manager-mobile",
    "version": "1.0.0",
    "owner": "trajetto",
    "orientation": "portrait",
    "description": "Sistema completo de gestão de frotas para empresas. Controle abastecimentos, manutenções, motoristas e veículos em tempo real.",
    "icon": "./assets/images/icon.png",
    "scheme": "trajetto",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#2563eb",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "jsEngine": "hermes",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "package": "com.trajetto.fleetmanager",
      "icon": "./assets/images/icon.png",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "platforms": [
      "android"
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/612e28c2-8647-4f68-b7dd-db9e60a4de2b"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app acessa suas fotos para permitir que você escolha uma imagem.",
          "cameraPermission": "O app acessa sua câmera para registrar fotos de abastecimentos e checklists.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que $(PRODUCT_NAME) acesse sua localização.",
          "locationWhenInUsePermission": "Permitir que $(PRODUCT_NAME) acesse sua localização."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb",
          "defaultChannel": "default"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "612e28c2-8647-4f68-b7dd-db9e60a4de2b"
      }
    }
  }
}
