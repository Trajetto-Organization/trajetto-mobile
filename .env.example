# ENVIRONMENT
NODE_ENV=development

# API CONFIGURATION
EXPO_PUBLIC_API_URL=http://localhost:3333

# WEB URL
EXPO_PUBLIC_WEB_APPLICATION_URL=http://localhost:3000/login

# SCREEN-OFF TRACKING: keep false (decision 7.3).
# "true" puts ACCESS_BACKGROUND_LOCATION and the location foreground service in
# the build's MANIFEST (app.config.js). Set it only in the EAS environment of a
# build made after Google approves the background location declaration and its
# video in the Play Console (docs/deploy.md, background location section). While it is false
# the control tower only sees a driver who has the app open.
EXPO_PUBLIC_BACKGROUND_TRACKING=false

# EAS DOES NOT READ THIS FILE.
# `eas build` and `eas update` take their variables from the EAS environment
# named in eas.json (development, preview, production; EAS has no custom
# environments on this plan, so the staging profile reads preview), set on
# expo.dev or with `eas env:create` (every variable, per environment:
# docs/variaveis-de-ambiente.md). Each release environment needs:
#   EXPO_PUBLIC_API_URL and EXPO_PUBLIC_WEB_APPLICATION_URL: HTTPS, public
#     host; staging points to the staging stack, production to production.
#   APP_ENV=<the EAS environment name>: `eas update` runs the same URL check.
#   GOOGLE_SERVICES_JSON: a FILE variable with the Firebase Android config
#     (google-services.json). CI checkouts never have the gitignored file, and
#     a release build without it stops on the EAS worker. Once per project:
#       eas env:create --scope project --name GOOGLE_SERVICES_JSON --type file \
#         --value ./google-services.json --visibility secret \
#         --environment preview --environment production
#     Keep the local file identical to it: `eas update` from this machine
#     hashes the local copy into the runtime version, the build hashes the
#     EAS one, and different contents mean OTA updates never reach the build.
